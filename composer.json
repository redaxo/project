{
    "name": "redaxo/project",
    "type": "project",
    "description": "REDAXO project skeleton for `composer create-project`",
    "keywords": ["redaxo", "cms", "skeleton", "project"],
    "license": "MIT",
    "authors": [
        {
            "name": "Yakamara Media GmbH & Co. KG",
            "homepage": "https://yakamara.de"
        },
        {
            "name": "REDAXO team & community",
            "homepage": "https://redaxo.org"
        }
    ],
    "homepage": "https://redaxo.org",
    "support": {
        "issues": "https://github.com/redaxo/core/issues",
        "security": "https://github.com/redaxo/core/security/policy"
    },

    "require": {
        "php": "^8.5",
        "redaxo/core": "^6.0"
    },

    "autoload": {
        "psr-4": {
            "Project\\": "src/"
        }
    },

    "config": {
        "allow-plugins": {
            "redaxo/composer-plugin": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },

    "minimum-stability": "dev",
    "prefer-stable": true
}
